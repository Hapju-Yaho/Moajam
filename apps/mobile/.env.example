# Android emulator: http://10.0.2.2:3000/v1
# Physical device: http://<computer-LAN-IP>:3000/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
# true: mock data without the backend; false or omitted: real API.
EXPO_PUBLIC_USE_MOCK_DATA=false

# HTTPS callback hosted by apps/web; register this exact URI in Kakao and backend allowlist.
# The callback page returns to moajam://auth/callback in a development/production app build.
EXPO_PUBLIC_KAKAO_REDIRECT_URI=
