{
  "name": "@moajam/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/database.mjs --generate && node scripts/database.mjs && node scripts/dev.mjs",
    "build": "node scripts/database.mjs --generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f -fe .js",
    "postinstall": "node scripts/database.mjs --generate",
    "start": "node scripts/database.mjs && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/health/health.controller.spec.ts src/workspaces/workspaces.controller.spec.ts src/config/database-url.spec.ts src/common/auth/kakao.client.spec.ts src/common/auth/auth.service.spec.ts src/media/r2-bucket.spec.ts",
    "prisma:generate": "node scripts/database.mjs --generate",
    "prisma:migrate": "node scripts/database.mjs --migrate",
    "prisma:deploy": "node scripts/database.mjs --deploy",
    "prisma:studio": "node scripts/database.mjs --studio",
    "db:local": "node scripts/database.mjs",
    "profiles:migrate": "node scripts/migrate-profile-photos.mjs",
    "test:integration": "npm run build && node --test --test-concurrency=1 test/local-api.test.mjs test/sqlite-defaults.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-fastify": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.116.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.13"
  }
}
