NODE_ENV=development
PORT=3000

# Blank: SQLite at <repository>/data/moajam.db.
# Set: external PostgreSQL (Supabase). This is a PostgreSQL URL, not an HTTPS URL.
DATABASE_URL=
DIRECT_URL=

# Kakao login is the default. temporary is an explicit development-only option.
AUTH_MODE=kakao
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Exact URLs also registered in Kakao Developers; comma separated.
KAKAO_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/kakao/callback,http://127.0.0.1:5173/auth/kakao/callback
# Server-only random secret of at least 32 bytes. Never expose it to the frontend.
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600

# File storage is independent from the database and Kakao login.
# Blank: local files with SQLite, Supabase Storage with PostgreSQL (legacy defaults).
# Set r2 to store files in Cloudflare R2. See docs/cloudflare-r2.md.
STORAGE_PROVIDER=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=moajam-private

# Only STORAGE_PROVIDER=supabase needs these settings.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
MEDIA_BUCKET=moajam-private
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_API_URL=
ENABLE_MEDIA_WORKER=false
MEDIA_PYTHON=python
