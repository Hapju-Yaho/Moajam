{
  "name": "moajam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13",
    "npm": ">=11"
  },
  "scripts": {
    "docs:api": "node scripts/api-docs.mjs",
    "docs:check": "node scripts/check-api-docs.mjs",
    "docs:catalog": "node scripts/check-api-docs.mjs --write-catalog",
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace @moajam/server",
    "dev:web": "npm run dev --workspace @moajam/web",
    "dev:mobile": "npm run dev --workspace @moajam/mobile",
    "build": "npm run build --workspace @moajam/web",
    "build:server": "npm run build --workspace @moajam/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "js-yaml": "4.3.2",
    "prettier": "^3.6.2",
    "swagger-ui-dist": "5.32.14",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.1"
  }
}
